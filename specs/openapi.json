        ]
      },
      "Content": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "expires_at": {
            "type": "integer"
          },
          "demo": {
            "type": "boolean"
          },
          "session_id": {
            "type": "string"
          }
        },
        "required": [
