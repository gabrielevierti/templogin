            "maxLength": 80
          }
        },
        "required": [
          "device_name"
        ]
      },
      "Pairing": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "device_code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "user_code": {
            "type": "string",
            "pattern": "^[A-Z2-9]{5}-[A-Z2-9]{5}$"
          },
          "verification_uri": {
            "type": "string",
            "format": "uri"
          },
          "verification_uri_complete": {
            "type": "string",
            "format": "uri"
          },
          "expires_in": {
            "type": "integer"
          },
          "interval": {
            "type": "integer"
          }
        },
        "required": [
          "device_code",
          "user_code",
          "verification_uri",
          "verification_uri_complete",
          "expires_in",
          "interval"
        ]
      },
      "Context": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "device_name": {
            "type": "string"
          },
          "user_code": {
            "type": "string",
            "pattern": "^[A-Z2-9]{5}-[A-Z2-9]{5}$"
          },
          "status": {
            "enum": [
              "pending",
              "approved",
              "denied",
              "consumed"
            ]
          },
          "expires_at": {
            "type": "integer"
          },
          "max_duration_seconds": {
            "type": "integer"
          },
          "device_verified": {
            "const": false
          }
        },
        "required": [
          "provider",
          "account",
          "device_name",
          "user_code",
          "status",
          "expires_at",
          "max_duration_seconds",
          "device_verified"
        ]
      },
      "DecisionRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z2-9]{5}-[A-Z2-9]{5}$"
          },
          "matching_code": {
            "type": "string",
            "pattern": "^[A-Z2-9]{5}-[A-Z2-9]{5}$"
          },
          "approve": {
            "type": "boolean"
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          }
        },
        "required": [
          "code",
          "matching_code",
          "approve",
          "duration_seconds"
        ]
      },
      "Decision": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "const": "denied"
              }
            },
            "required": [
              "status"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "const": "approved"
              },
              "session_id": {
                "type": "string"
              },
              "expires_at": {
                "type": "integer"
              }
            },
            "required": [
              "status",
              "session_id",
              "expires_at"
            ]
          }
        ]
      },
      "TokenRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "device_code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        },
        "required": [
          "device_code"
        ]
      },
      "Token": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "access_token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "token_type": {
            "const": "Bearer"
          },
          "expires_at": {
            "type": "integer"
          },
          "session_id": {
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "token_type",
          "expires_at",
          "session_id"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "device_name": {
            "type": "string"
          },
          "expires_at": {
            "type": "integer"
          },
          "revoked": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "device_name",
          "expires_at",
          "revoked"
        ]
      },
      "Empty": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
