      "Revoked": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "revoked"
          }
        },
        "required": [
          "status"
        ]
      },
      "Config": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ]
          },
          "max_duration_seconds": {
            "type": "integer"
          },
          "account_required": {
            "const": false
          }
        },
        "required": [
