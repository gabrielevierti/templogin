          "expires_at",
          "demo",
          "session_id"
        ]
      }
    },
    "securitySchemes": {
      "providerSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "provider_session",
        "description": "Representative name only: identity callback validates the real host login/session."
