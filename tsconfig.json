{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "services/**/*.ts",
    "packages/**/*.ts",
    "apps/**/*.ts",
    "tests/**/*.ts",
    "*.ts",
    "scripts/**/*.ts",
    "examples/**/*.ts"
  ]
}
